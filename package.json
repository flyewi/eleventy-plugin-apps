{
  "name": "@flyewi/eleventy-plugin-apps",
  "version": "0.2.0",
  "description": "Eleventy plugin that mounts separately built single-page apps (Angular, Ionic, …) under subpaths of your site, checks their base href, and exposes their URLs and versions to templates.",
  "main": "lib/apps.js",
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "eleventy",
    "eleventy-plugin",
    "11ty",
    "spa",
    "angular",
    "ionic",
    "capacitor",
    "passthrough",
    "htaccess"
  ],
  "author": "flyewi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyewi/eleventy-plugin-apps.git"
  },
  "homepage": "https://github.com/flyewi/eleventy-plugin-apps#readme",
  "bugs": {
    "url": "https://github.com/flyewi/eleventy-plugin-apps/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@11ty/eleventy": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  }
}
